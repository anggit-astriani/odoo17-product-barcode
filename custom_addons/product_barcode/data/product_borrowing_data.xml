<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Product Borrowing -->
        <record id="seq_product_borrowing" model="ir.sequence">
            <field name="name">Product Borrowing Sequence</field>
            <field name="code">product.borrowing</field>
            <field name="prefix">BRW/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Cron Job for Checking Overdue Borrowings -->
        <record id="cron_check_overdue_borrowings" model="ir.cron">
            <field name="name">Check Overdue Product Borrowings</field>
            <field name="model_id" ref="model_product_borrowing"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>