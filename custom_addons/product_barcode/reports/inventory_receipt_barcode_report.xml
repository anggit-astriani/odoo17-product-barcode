<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Custom Paper Format without border -->
        <record id="paperformat_barcode_label" model="report.paperformat">
            <field name="name">Barcode Label Format</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- Template Definition -->
        <template id="report_inventory_barcode_document">
            <t t-call="web.basic_layout">
                <div class="page">
                    <style>
                        @page {
                            margin: 5mm;
                            border: none;
                            box-shadow: none;
                        }
                        body, html {
                            border: none !important;
                            box-shadow: none !important;
                        }
                        div.page {
                            border: none !important;
                            box-shadow: none !important;
                            page-break-after: always;
                        }
                        .barcode-table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                            border: 0px !important;
                        }
                        .barcode-table tbody {
                            border: none !important;
                        }
                        .barcode-table tr {
                            border: 0px !important;
                        }
                        .barcode-table td {
                            border: 0px !important;
                        }
                        .barcode-cell {
                            width: 33.33%;
                            padding: 8px;
                            vertical-align: middle;
                            border: 0px solid transparent !important;
                            text-align: center;
                        }
                    </style>

                    <table class="barcode-table" cellpadding="0" cellspacing="0" border="0">
                        <tbody>
                            <t t-foreach="docs" t-as="o">
                                <!-- Start new row every 3 barcodes -->
                                <tr t-if="o_index % 3 == 0" style="border:0px;">
                                    <!-- First column -->
                                    <td class="barcode-cell" style="border:0px;">
                                        <div style="margin:0px auto;">
                                            <t t-if="docs[o_index].barcode">
                                                <t t-set="barcode_url" t-value="'/report/barcode/EAN13/%s?width=600&amp;height=150&amp;humanreadable=1' % docs[o_index].barcode"/>
                                                <img t-att-src="barcode_url" 
                                                     style="max-width:250px; border:1px solid #ccc; padding:10px;"
                                                     alt="Barcode"/>
                                            </t>
                                            <t t-else="">
                                                <div style="border:2px dashed red; padding:20px; color:red;">
                                                    <p><strong>ERROR:</strong> Barcode field is empty!</p>
                                                    <p>Please generate barcode first</p>
                                                </div>
                                            </t>
                                        </div>
                                    </td>
                                    
                                    <!-- Second column -->
                                    <td class="barcode-cell" style="border:0px;" t-if="o_index + 1 &lt; len(docs)">
                                        <div style="margin:0px auto;">
                                            <t t-if="docs[o_index + 1].barcode">
                                                <t t-set="barcode_url" t-value="'/report/barcode/EAN13/%s?width=600&amp;height=150&amp;humanreadable=1' % docs[o_index + 1].barcode"/>
                                                <img t-att-src="barcode_url" 
                                                     style="max-width:250px; border:1px solid #ccc; padding:10px;"
                                                     alt="Barcode"/>
                                            </t>
                                            <t t-else="">
                                                <div style="border:2px dashed red; padding:20px; color:red;">
                                                    <p><strong>ERROR:</strong> Barcode field is empty!</p>
                                                    <p>Please generate barcode first</p>
                                                </div>
                                            </t>
                                        </div>
                                    </td>
                                    <td class="barcode-cell" style="border:0px;" t-else=""></td>
                                    
                                    <!-- Third column -->
                                    <td class="barcode-cell" style="border:0px;" t-if="o_index + 2 &lt; len(docs)">
                                        <div style="margin:0px auto;">
                                            <t t-if="docs[o_index + 2].barcode">
                                                <t t-set="barcode_url" t-value="'/report/barcode/EAN13/%s?width=600&amp;height=150&amp;humanreadable=1' % docs[o_index + 2].barcode"/>
                                                <img t-att-src="barcode_url" 
                                                     style="max-width:250px; border:1px solid #ccc; padding:10px;"
                                                     alt="Barcode"/>
                                            </t>
                                            <t t-else="">
                                                <div style="border:2px dashed red; padding:20px; color:red;">
                                                    <p><strong>ERROR:</strong> Barcode field is empty!</p>
                                                    <p>Please generate barcode first</p>
                                                </div>
                                            </t>
                                        </div>
                                    </td>
                                    <td class="barcode-cell" style="border:0px;" t-else=""></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>

        <!-- Report Action Definition -->
        <record id="action_report_inventory_barcode" model="ir.actions.report">
            <field name="name">Product Barcode Label</field>
            <field name="model">inventory.receipt.product.detail</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">product_barcode.report_inventory_barcode_document</field>
            <field name="report_file">product_barcode.report_inventory_barcode_document</field>
            <field name="binding_model_id" ref="model_inventory_receipt_product_detail"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_barcode_label"/>
        </record>
    </data>
</odoo>