<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_inventory_return_product_tree" model="ir.ui.view">
        <field name="name">inventory.return.product.tree</field>
        <field name="model">inventory.return.product</field>
        <field name="arch" type="xml">
            <tree string="Product Returns" decoration-info="state=='draft'" 
                  decoration-primary="state=='confirmed'" decoration-success="state=='done'" 
                  decoration-muted="state=='cancel'">
                <field name="name"/>
                <field name="delivery_id"/>
                <field name="partner_id"/>
                <field name="return_date"/>
                <field name="warehouse_id"/>
                <field name="total_lines"/>
                <field name="returned_count"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" 
                       decoration-info="state=='draft'"
                       decoration-primary="state=='confirmed'"
                       decoration-success="state=='done'"
                       decoration-danger="state=='cancel'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_inventory_return_product_form" model="ir.ui.view">
        <field name="name">inventory.return.product.form</field>
        <field name="model">inventory.return.product</field>
        <field name="arch" type="xml">
            <form string="Product Return">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_process_return" string="Process All Returns" type="object" 
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state in ['done', 'cancel']" 
                            confirm="Are you sure you want to cancel this return?"/>
                    <button name="action_draft" string="Set to Draft" type="object" 
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="delivery_id" 
                                   options="{'no_create': True, 'no_open': True}"
                                   readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="1" force_save="1"/>
                            <field name="warehouse_id" 
                                   options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="return_date" readonly="state != 'draft'"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    
                    <notebook>
                    <!-- Tab 1: Operations (Stock Movement) -->
                        <page string="Operations" name="operations">
                            <div class="alert alert-success" role="alert">
                                <strong>Operations:</strong> Tab ini menampilkan ringkasan produk yang akan di-return dan mempengaruhi stock warehouse.<br/>
                                - <strong>Demand:</strong> Jumlah yang diharapkan untuk di-return (dapat diinput manual sebagai referensi)<br/>
                                - <strong>Quantity:</strong> Jumlah aktual produk yang di-scan - <strong>INI YANG AKAN MEMPENGARUHI STOCK</strong><br/>
                                Operations akan otomatis ter-generate setelah <strong>Confirm</strong>.
                            </div>
                            <field name="operation_ids" 
                                readonly="state in ['done', 'cancel']">
                                <tree editable="bottom" create="0" delete="0" 
                                    decoration-warning="quantity != demand"
                                    decoration-success="quantity == demand">
                                    <field name="product_id" readonly="1"/>
                                    <field name="demand" 
                                        string="Demand (Expected)"
                                        readonly="state in ['done', 'cancel']"/>
                                    <field name="quantity" readonly="1" 
                                        string="Quantity (Actual - Affects Stock)"/>
                                    <field name="state" column_invisible="1"/>
                                </tree>
                                <form string="Operation">
                                    <group>
                                        <group>
                                            <field name="product_id" readonly="1"/>
                                            <field name="demand" 
                                                readonly="state in ['done', 'cancel']"/>
                                        </group>
                                        <group>
                                            <field name="quantity" readonly="1"/>
                                            <field name="state" invisible="1"/>
                                        </group>
                                    </group>
                                    <div class="alert alert-warning" role="alert" 
                                        invisible="quantity == demand">
                                        <strong>Warning:</strong> Quantity berbeda dengan Demand!<br/>
                                        Stock akan diupdate berdasarkan <strong>Quantity</strong> (<field name="quantity" readonly="1"/> unit).
                                    </div>
                                    <div class="alert alert-success" role="alert" 
                                        invisible="quantity != demand">
                                        <strong>OK:</strong> Quantity sesuai dengan Demand.
                                    </div>
                                </form>
                            </field>
                        </page>

                        <!-- Tab 2: Return Items (Scan Barcode) -->
                        <page string="Return Items" name="return_items">
                            <div class="alert alert-info" role="alert">
                                <strong>Scan Barcode:</strong> Scan barcode produk yang akan di-return. 
                                Setelah semua barcode di-scan, klik <strong>Confirm</strong> untuk generate Operations.
                            </div>
                            <field name="line_ids" 
                                   context="{'default_return_id': active_id}"
                                   readonly="state in ['done', 'cancel']">
                                <tree editable="bottom" decoration-success="is_processed==True">
                                    <field name="barcode_scanned" placeholder="Scan barcode di sini..."/>
                                    <field name="product_detail_id" readonly="1" force_save="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="code_product" readonly="1"/>
                                    <field name="warehouse_id" readonly="1" optional="hide"/>
                                    <field name="condition" required="1"/>
                                    <field name="return_reason" required="1"/>
                                    <field name="destination_location" readonly="1"/>
                                    <field name="new_status" readonly="1"/>
                                    <field name="notes"/>
                                    <field name="is_processed" readonly="1"/>
                                    <field name="processed_date" readonly="1" optional="hide"/>
                                    <field name="state" column_invisible="1"/>
                                </tree>
                                <form string="Return Item">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="barcode_scanned" placeholder="Scan atau ketik barcode"/>
                                                <field name="product_detail_id" readonly="1"/>
                                                <field name="product_id" readonly="1"/>
                                                <field name="code_product" readonly="1"/>
                                                <field name="warehouse_id" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="condition" widget="radio"/>
                                                <field name="return_reason"/>
                                                <field name="destination_location" readonly="1"/>
                                                <field name="new_status" readonly="1"/>
                                            </group>
                                        </group>
                                        <group>
                                            <field name="notes" placeholder="Catatan tambahan tentang kondisi barang..."/>
                                        </group>
                                        <group string="Foto Kondisi Barang">
                                            <field name="image" widget="image" options="{'size': [400, 300]}"/>
                                        </group>
                                        <group>
                                            <group>
                                                <field name="is_processed" readonly="1"/>
                                                <field name="processed_date" readonly="1"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        
                        <!-- Tab 3: Notes -->
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Catatan umum untuk return ini..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_inventory_return_product_search" model="ir.ui.view">
        <field name="name">inventory.return.product.search</field>
        <field name="model">inventory.return.product</field>
        <field name="arch" type="xml">
            <search string="Search Returns">
                <field name="name" string="Return Number"/>
                <field name="delivery_id" string="Delivery Order"/>
                <field name="partner_id" string="Customer"/>
                <field name="warehouse_id" string="Warehouse"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <separator/>
                <filter string="My Returns" name="my_returns" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter string="Return Date" name="return_date" date="return_date"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by':'warehouse_id'}"/>
                    <filter string="Return Date" name="group_return_date" context="{'group_by':'return_date:month'}"/>
                    <filter string="Responsible" name="group_user" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_inventory_return_product" model="ir.actions.act_window">
        <field name="name">Product Returns</field>
        <field name="res_model">inventory.return.product</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Product Return
            </p>
            <p>
                Return products from delivered orders by scanning barcodes and specifying the condition.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_inventory_return_product"
              name="Product Returns"
              parent="stock.menu_stock_root"
              action="action_inventory_return_product"
              sequence="20"/>
</odoo>