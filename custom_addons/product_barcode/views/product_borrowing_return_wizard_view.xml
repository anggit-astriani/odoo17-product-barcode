<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_borrowing_return_wizard_form" model="ir.ui.view">
        <field name="name">product.borrowing.return.wizard.form</field>
        <field name="model">product.borrowing.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Borrowed Products" class="oe_form_boxed">
                <sheet>
                    <!-- Header -->
                    <h3>
                        <field name="borrowing_id" readonly="1" class="oe_inline"/>
                    </h3>

                    <!-- Return Date -->
                    <group col="2" class="mb-3">
                        <field name="return_date" required="1"/>
                    </group>

                    <!-- Notes full width -->
                    <group string="Return Notes" colspan="2">
                        <field name="notes" nolabel="1" colspan="2"
                               placeholder="Add general return notes (applies to all returned items)..."
                               style="width:100%; height:100px;"/>
                    </group>

                    <separator string="Items to Return" colspan="2"/>

                    <!-- Lines -->
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom" string="Items to Return">
                            <field name="to_return" widget="boolean_toggle" string="Return?"/>
                            <field name="barcode" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="return_condition"/>
                            <field name="return_notes"/>
                            <field name="borrowing_line_id" invisible="1" optional="hide"/>
                        </tree>
                    </field>

                    <footer>
                        <button name="action_process_return"
                                string="Process Return"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_product_borrowing_return_wizard" model="ir.actions.act_window">
        <field name="name">Return Borrowed Products</field>
        <field name="res_model">product.borrowing.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_product_borrowing_return_wizard_form"/>
    </record>
</odoo>
