<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="view_picking_form_add_detail_product" model="ir.ui.view">
            <field name="name">stock.picking.form.add.detail.product</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='note']" position="after">
                    <page string="Detail Product" name="detail_receipt_product_page" id="detail_receipt_product_page" invisible="(picking_type_code != 'incoming') or ('Return of' in (origin or '')) or (state == 'draft')">
                        <div class="oe_button_box mb-3" style="margin-bottom: 10px;">

                            <button name="action_generate_barcodes"
                                    string="Generate Barcodes"
                                    type="object"
                                    class="oe_stat_button btn-secondary"
                                    icon="fa-barcode"
                                    help="Generate barcodes berdasarkan quantity di Operations tab"
                                    invisible="state != 'assigned'"/>
                            
                            <button name="action_print_all_barcodes"
                                    string="Print All Barcode"
                                    type="object"
                                    class="oe_stat_button btn-primary ms-2"
                                    icon="fa-print"
                                    help="Print semua barcode yang belum ter-print dengan status Waiting"/>
                        </div>
                        
                        <div class="alert alert-info" role="alert">
                            <h4 class="alert-heading">
                                <i class="fa fa-info-circle"/> Cara Penggunaan:
                            </h4>
                            <ol style="margin-bottom: 0;">
                                <li><strong>Step 1:</strong> Klik button "<strong>Generate Barcodes</strong>" untuk membuat barcode otomatis berdasarkan quantity di tab Operations.</li>
                                <li><strong>Step 2:</strong> Setelah barcode ter-generate, klik button "<strong>Print All Barcode</strong>" untuk print semua barcode sekaligus.</li>
                                <!-- <li>Barcode yang sudah di-print akan memiliki status "Printed" dan tidak akan di-print ulang.</li> -->
                            </ol>
                        </div>

                        <!-- Button Generate Barcode -->
                        <div class="oe_button_box mb-3" style="margin-bottom: 10px;">
                            <button name="action_generate_barcodes"
                                    string="Generate Barcodes"
                                    type="object"
                                    class="oe_stat_button btn-primary"
                                    icon="fa-barcode"
                                    help="Generate barcodes berdasarkan quantity di Operations tab"/>
                        </div>
                        
                        <!-- Info Box -->
                        <div class="alert alert-info" role="alert">
                            <strong>Generate Barcodes:</strong> Click button di atas untuk generate barcode otomatis 
                            berdasarkan quantity di tab Operations. Contoh: jika quantity = 3, akan generate 3 barcode berbeda.
                        </div>

                        <field name="receipt_product_detail_line_ids" widget="one2many_list">
                            <tree editable="bottom" create="1" delete="1">
                                <field name="receipt_id"/>
                                <field name="vendor_id"/>
                                <field name="vendor_code"/>
                                <field name="product_id"/>
                                <field name="code_product"/>
                                <field name="purchase_id"/>
                                <field name="warehouse_id"/>
                                <!-- <field name="delivery_id"/> -->
                                <field name="unique_code"/>
                                <field name="barcode"/>
                                <!-- <field name="condition"/>
                                <field name="information"/> -->
                                <field name="status_product" widget="badge"
                                    decoration-secondary="status_product == 'waiting'"
                                    decoration-success="status_product == 'available'"
                                    decoration-warning="status_product == 'scanned'"
                                    decoration-primary="status_product == 'moving'"
                                    decoration-danger="status_product == 'sold'"/>
                                <field name="print_status" widget="badge" 
                                    decoration-secondary="print_status == 'not_printed'"
                                    decoration-warning="print_status == 'printed'"/>
                                <button name="action_print_barcode"
                                        string="Print Barcode"
                                        type="object"
                                        icon="fa-print"
                                        context="{'active_model':'inventory.receipt.product.detail'}"/>
                            </tree>
                        </field>
                    </page>

                    <page string="Transfer Product" name="detail_transfer_product_page" invisible="(picking_type_code != 'internal')">
                        <field name="transfer_product_detail_line_ids" widget="one2many_list" readonly="state != 'draft'">
                            <tree editable="bottom" create="1" delete="1">
                                <field name="transfer_id"/>
                                <field name="product_detail_id"/>
                                <!-- <field name="barcode"/> -->
                                <field name="product_id"/>
                                <field name="code_product"/>
                                <field name="from_warehouse_id"/>
                                <field name="to_warehouse_id"/>
                                <field name="status_product"/>
                                <!-- <button name="action_print_barcode"
                                        string="Print Barcode"
                                        type="object"
                                        icon="fa-print"
                                        context="{'active_model':'inventory.receipt.product.detail'}"/> -->
                            </tree>
                        </field>
                    </page>

                    <page string="Receive Transfer Product" name="detail_transfer_receive_product_page" invisible="(picking_type_code != 'internal') or (state == 'draft')">
                        <field name="transfer_receive_product_detail_line_ids" widget="one2many_list" readonly="state != 'assigned'">
                            <tree editable="bottom" create="1" delete="1">
                                <field name="transfer_id"/>
                                <field name="product_transfer_id"/>
                                <!-- <field name="barcode"/> -->
                                <field name="product_id"/>
                                <field name="code_product"/>
                                <field name="from_warehouse_id"/>
                                <field name="to_warehouse_id"/>
                                <field name="received_date"/>
                                <!-- <button name="action_print_barcode"
                                        string="Print Barcode"
                                        type="object"
                                        icon="fa-print"
                                        context="{'active_model':'inventory.receipt.product.detail'}"/> -->
                            </tree>
                        </field>
                    </page>

                    <page string="Detail Product" name="detail_delivery_product_page" invisible="(picking_type_code != 'outgoing') or (state == 'draft')">
                        <field name="delivery_product_detail_line_ids" widget="one2many_list" context="{'default_delivery_id': active_id}">
                            <tree editable="bottom" create="1" delete="1">
                                <field name="delivery_id"/>
                                <field name="receipt_code_product"/>
                                <!-- <field name="barcode"/> -->
                                <field name="product_id"/>
                                <field name="warehouse_id"/>
                                <field name="receipt_id"/>
                                <field name="status_product"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
</odoo>
